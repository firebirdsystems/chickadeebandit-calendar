{
  "id": "calendar",
  "name": "Calendar",
  "version": "1.0.0",
  "description": "Family calendar with manual event creation, recurring events, and series editing. Shows month and agenda views. Merges in events synced from Google Calendar and Apple Calendar. Filter by family member, see who's busy each day, and get warned about scheduling conflicts.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": [
    "calendar",
    "events",
    "scheduling",
    "recurrence",
    "google",
    "apple"
  ],
  "data_access": {
    "reads": [
      "family.members",
      "family.calendar",
      "cross.calendar_events"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "nav": {
    "label": "Calendar"
  },
  "widget": {
    "label": "Calendar",
    "size": "small"
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT title, start_date AS at FROM app_calendar__events WHERE start_date >= date('now') ORDER BY start_date LIMIT 3"
    },
    "display": { "template": "list", "title": "title", "when": "at" }
  },
  "resource_limits": {
    "max_db_bytes": 104857600
  },
  "icon": "📅",
  "ai_access": {
    "allowed": true,
    "mode": "read_write",
    "db_exports": ["upcoming_events", "events_this_week"],
    "db_mutations": ["cancel_event", "reschedule_event"],
    "db_inserts": ["add_event"]
  }
}
