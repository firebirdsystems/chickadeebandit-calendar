{
  "id": "calendar",
  "name": "Calendar",
  "version": "1.0.0",
  "description": "Family calendar with manual event creation, recurring events, and series editing. Shows month and agenda views. Merges in events synced from Google Calendar and Apple Calendar. Filter by family member, see who's busy each day, and get warned about scheduling conflicts.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": [
    "calendar",
    "events",
    "scheduling",
    "recurrence",
    "google",
    "apple"
  ],
  "contexts": ["household", "shared_space", "shared_space.roster"],
  "data_access": {
    "reads": [
      "family.members",
      "family.calendar",
      "cross.calendar_events"
    ],
    "writes": []
  },
  "member_references": {
    "events": [
      { "column": "attendee_ids", "on_removed": "prune_list" },
      { "column": "organizer_id", "on_removed": "keep" },
      { "column": "created_by", "on_removed": "keep" }
    ]
  },
  "row_policies": {
    "events": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_visibility_scoped": true,
      "steward_writes_only": true
    }
  },
  "publishes": ["calendar.event_created"],
  "publish_acls": {"calendar.event_created": {"require_role": "member"}},
  "automation_actions": {
    "create_event": {
      "title": "Put a date on the calendar",
      "description": "Add an all-day event when another app records something dated — a care visit, a capsule's reveal date, an appointment.",
      "params": {
        "title": { "type": "text", "label": "Event title", "required": true },
        "event_date": { "type": "text", "label": "Date (yyyy-mm-dd)", "required": true },
        "description": { "type": "text", "label": "Description", "default": "" }
      },
      "dedupe": { "table": "events", "column": "source_event_id" },
      "steps": [
        {
          "op": "insert",
          "table": "events",
          "values": {
            "id": "$uuid",
            "title": ":title",
            "description": ":description",
            "start_date": ":event_date",
            "end_date": ":event_date",
            "all_day": "1",
            "created_by": "automation",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "suggested_automations": [
    {
      "title": "Put elder-care appointments on the calendar",
      "description": "An appointment added in the elder-care app becomes an all-day calendar event, so whoever is driving sees it on Today without opening that app.",
      "trigger_event": "elder_care.appointment_added",
      "target_app_id": "calendar",
      "action_id": "create_event",
      "param_map": {
        "title": { "kind": "payload_field", "value": "title" },
        "event_date": { "kind": "payload_field", "value": "date" }
      }
    },
    {
      "title": "Put scheduled elder-care visits on the calendar",
      "description": "When a visit is scheduled, it lands on the shared calendar so the rota is visible to everyone, not only inside the elder-care app.",
      "trigger_event": "elder_care.visit_scheduled",
      "target_app_id": "calendar",
      "action_id": "create_event",
      "param_map": {
        "title": { "kind": "const", "value": "Elder-care visit" },
        "event_date": { "kind": "payload_field", "value": "date" }
      }
    },
    {
      "title": "Put a time capsule's reveal date on the calendar",
      "description": "Sealing a capsule adds its reveal date to the calendar, so the day it opens doesn't pass unnoticed months later.",
      "trigger_event": "time_capsule.created",
      "target_app_id": "calendar",
      "action_id": "create_event",
      "param_map": {
        "title": { "kind": "payload_field", "value": "title" },
        "event_date": { "kind": "payload_field", "value": "reveal_date" }
      }
    }
  ],
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "capture_consumer": { "kinds": ["event"], "via": "structured" },
  "nav": {
    "label": "Calendar"
  },
  "widget": {
    "label": "Calendar",
    "size": "small"
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT title, start_date AS at FROM app_calendar__events WHERE is_cancelled = 0 AND start_date >= :today ORDER BY start_date LIMIT 3"
    },
    "display": { "template": "list", "title": "title", "when": "at" }
  },
  "resource_limits": {
    "max_db_bytes": 104857600
  },
  "icon": "📅",
  "ai_access": {
    "allowed": true,
    "mode": "read_write",
    "db_exports": ["upcoming_events", "events_this_week"],
    "db_mutations": ["cancel_event", "reschedule_event"],
    "db_inserts": ["add_event"]
  }
}
